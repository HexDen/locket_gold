<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>PayloadDisplayName</key>
	<string>Locket Gold DNS Chống Thu Hồi (HexDen)</string>

	<key>PayloadDescription</key>
	<string>Cấu hình Split DNS duy trì Locket Gold vĩnh viễn không cần VPN, bảo vệ bản quyền và chống thu hồi chứng chỉ Apple.</string>

	<key>PayloadIdentifier</key>
	<string>com.HexDen.locketgold.dns.a2dd89.profile</string>

	<key>PayloadScope</key>
	<string>System</string>

	<key>PayloadType</key>
	<string>Configuration</string>

	<key>PayloadUUID</key>
	<string>3C6C2652-9FA8-4D48-9F55-52B19F0D24B1</string>

	<key>PayloadVersion</key>
	<integer>1</integer>

	<key>PayloadOrganization</key>
	<string>HexDen (Văn Nguyên)</string>

	<key>PayloadContent</key>
	<array>
		<dict>
			<key>DNSSettings</key>
			<dict>
				<key>DNSProtocol</key>
				<string>HTTPS</string>

				<key>ServerURL</key>
				<string>https://apple.dns.nextdns.io/a2dd89/locketgold</string>

				<key>ServerAddresses</key>
				<array>
					<string>45.90.28.0</string>
					<string>45.90.30.0</string>
					<string>2a07:a8c0::a2:dd89</string>
					<string>2a07:a8c1::a2:dd89</string>
				</array>

				<key>SupplementalMatchDomains</key>
				<array>
					<!-- Duy trì Locket Gold vĩnh viễn không cần VPN (Chặn RevenueCat kiểm tra gói mua) -->
					<string>api.revenuecat.com</string>
					<string>app.revenuecat.com</string>
					<string>revenuecat.com</string>

					<!-- Chống thu hồi chứng chỉ Apple (ESign, Scarlet, GBox, TrollStore, IPA Doanh Nghiệp) -->
					<string>certs.apple.com</string>
					<string>certs.apple.com.edgekey.net</string>
					<string>crl.apple.com</string>
					<string>crl.apple.com.akadns.net</string>
					<string>crl.apple.com.edgekey.net</string>
					<string>crl.entrust.net</string>
					<string>crl3.digicert.com</string>
					<string>crl4.digicert.com</string>
					<string>ocsp-lb.apple.com.akadns.net</string>
					<string>ocsp.apple.com</string>
					<string>ocsp.apple.com.edgekey.net</string>
					<string>ocsp.digicert.cn</string>
					<string>ocsp.digicert.com</string>
					<string>ocsp2.apple.com</string>
					<string>ocsp2.apple.com.edgekey.net</string>
					<string>valid.apple.com</string>
					<string>valid.apple.com.akadns.net</string>
					<string>valid.apple.com.edgekey.net</string>
					<string>ppq.apple.com</string>
					<string>iadsdk.apple.com</string>
				</array>
			</dict>

			<key>OnDemandRules</key>
			<array>
				<dict>
					<key>Action</key>
					<string>EvaluateConnection</string>
					<key>ActionParameters</key>
					<array>
						<dict>
							<key>DomainAction</key>
							<string>NeverConnect</string>
							<key>Domains</key>
							<array>
								<string>captive.apple.com</string>
								<string>3gppnetwork.org</string>
								<string>dav.orange.fr</string>
								<string>vvm.mobistar.be</string>
								<string>vvm.mstore.msg.t-mobile.com</string>
								<string>tma.vvm.mone.pan-net.eu</string>
								<string>vvm.ee.co.uk</string>
							</array>
						</dict>
					</array>
				</dict>
				<dict>
					<key>Action</key>
					<string>Connect</string>
				</dict>
			</array>

			<key>PayloadType</key>
			<string>com.apple.dnsSettings.managed</string>
			<key>PayloadIdentifier</key>
			<string>com.HexDen.locketgold.dns.a2dd89.managed</string>
			<key>PayloadUUID</key>
			<string>62F0D8E9-2182-4E38-9844-3B9B3BC03417</string>
			<key>PayloadDisplayName</key>
			<string>Locket Gold DNS Chống Thu Hồi (HexDen)</string>
			<key>PayloadDescription</key>
			<string>Cấu hình DNS-over-HTTPS (DoH) bảo vệ Locket Gold và chống thu hồi chứng chỉ Apple vĩnh viễn.</string>
			<key>PayloadOrganization</key>
			<string>HexDen (Văn Nguyên)</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
		</dict>
	</array>

	<key>PayloadRemovalDisallowed</key>
	<false/>
</dict>
</plist>
